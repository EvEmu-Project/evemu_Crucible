# Keep the Docker build context explicit and independent of local Git metadata.
.git
.gitignore
build/
cmake-build-*/
**/CMakeFiles/
**/CMakeCache.txt
**/*.o
**/*.a
**/*.so
**/*.dll
**/*.exe

# Source and build inputs
!CMakeLists.txt
!config.h.in
!cmake/
!cmake/**
!dep/
!dep/**
!src/
!src/**
!utils/
!utils/**
!sql/
!sql/**
